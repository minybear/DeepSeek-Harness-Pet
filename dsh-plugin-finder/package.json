{
  "name": "@minybear/dsh-plugin-finder",
  "description": "Search the dsh.lanshuagent.com plugin hub (awesome-dsh-plugin) from inside DeepSeek Harness: a find_dsh_plugin tool that lists, filters, and returns install commands for DSH plugins.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minybear/dsh-plugin-finder.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "registry",
    "search",
    "plugin-hub",
    "awesome-dsh-plugin"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "scripts": {
    "test": "node test/catalog.test.mjs && node test/schema.test.mjs"
  },
  "files": [
    "lib/index.js",
    "lib/catalog.js",
    "cordis.patch.yml"
  ]
}
